<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UberApp.Views.ResetPasswordPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviour="clr-namespace:UberApp.Behaviors"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:control="clr-namespace:UberApp.Controls"
    xmlns:converter="clr-namespace:UberApp.Converters"
    xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
    xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
    Title="Reset Password" NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=background.jpg,
                                                                  iOSPhoneLandscape=LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=LoginBackground-Landscape.png}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:NameValidationConverter x:Key="FirstValidationErrorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <gradient:SfGradientView Style="{StaticResource BlueGradientStyle}" />

            <ScrollView HorizontalOptions="Center">
                <ScrollView.VerticalOptions>
                    <OnIdiom x:TypeArguments="LayoutOptions" Default="CenterAndExpand" Phone="FillAndExpand" />
                </ScrollView.VerticalOptions>

                <StackLayout Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32', PhoneLandscape='150,32',
                         TabletPortrait='200,50', TabletLandscape='300,50', Desktop='30'}" Spacing="0" 
                         WidthRequest="{OnPlatform Default='-1', UWP='350'}" VerticalOptions="FillAndExpand">

                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="24" VerticalOptions="CenterAndExpand">

                        <!--  Label to display the title of this page  -->
                        <Label Grid.Row="0" FontSize="20" Style="{StaticResource TitleLabelStyle}" Text="Reset Password"
                            TextColor="{DynamicResource Gray-White}" VerticalOptions="Center" />

                        <!--  Entry to get username from user  -->
                        <StackLayout  Grid.Row="2">
                            <border:SfBorder BorderColor="{Binding Source={x:Reference NameEntry}, Path=IsFocused, 
                                             Converter={StaticResource ColorConverter}, ConverterParameter=0}" 
                                             Style="{StaticResource LoginFormBorderlessEntryBorderStyle}">
                                <Grid ColumnDefinitions="*, Auto">

                                    <control:BorderlessEntry x:Name="NameEntry" Margin="15,0" HeightRequest="40" Placeholder="Name"
                                        PlaceholderColor="{StaticResource EntryPlaceholderColor}" Text="{Binding Name.Value}"
                                        Style="{StaticResource BorderlessEntryStyle}" TextColor="{StaticResource Gray-White}">
                                        <Entry.Behaviors>
                                            <behaviour:EntryLineValidationBehaviour IsValid="{Binding Name.IsValid}" />
                                        </Entry.Behaviors>
                                    </control:BorderlessEntry>

                                    <!--  Label to display error icon  -->
                                    <Label Grid.Column="1" IsVisible="{Binding Path=IsVisible, Source={x:Reference NameValidationLabel}}"
                                        Style="{StaticResource ErrorIconLabelStyle}" Text="{StaticResource Error}" />
                                </Grid>
                            </border:SfBorder>

                            <!--  Label to display error message  -->
                            <Label x:Name="NameValidationLabel" Margin="15,-3,0,0" Style="{StaticResource SimpleLabelStyle}"
                                IsVisible="{Binding Name.IsValid, Converter={StaticResource InverseBoolConverter}}"  
                                Text="{Binding Name.Errors, Converter={StaticResource FirstValidationErrorConverter}}"
                                TextColor="{DynamicResource Red}" VerticalOptions="FillAndExpand" />
                        </StackLayout>

                        <!--  Entry to get new password from user  -->
                        <StackLayout Grid.Row="3">
                            <border:SfBorder BorderColor="{Binding Source={x:Reference NewPasswordEntry}, Path=IsFocused, Converter={StaticResource ColorConverter}, ConverterParameter=0}" Style="{StaticResource LoginFormBorderlessEntryBorderStyle}">
                                <Grid ColumnDefinitions="*, Auto">

                                    <control:BorderlessEntry x:Name="NewPasswordEntry" Margin="15,0" HeightRequest="40"
                                        IsPassword="True" Placeholder="New Password" Style="{StaticResource BorderlessEntryStyle}"
                                        PlaceholderColor="{StaticResource EntryPlaceholderColor}"
                                        Text="{Binding Password.Item1.Value}" TextColor="{StaticResource Gray-White}">
                                        <Entry.Behaviors>
                                            <behaviour:EntryLineValidationBehaviour IsValid="{Binding Password.Item1.IsValid}" />
                                        </Entry.Behaviors>
                                    </control:BorderlessEntry>

                                    <!--  Label to display error icon  -->
                                    <Label Grid.Column="1" Style="{StaticResource ErrorIconLabelStyle}" Text="{StaticResource Error}" 
                                           IsVisible="{Binding Path=IsVisible, Source={x:Reference PasswordValidationLabel}}"/>
                                </Grid>
                            </border:SfBorder>

                            <!--  Label to display error message  -->
                            <Label
                                x:Name="PasswordValidationLabel"
                                Margin="15,-3,0,0"
                                IsVisible="{Binding Password.Item1.IsValid, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SimpleLabelStyle}"
                                Text="{Binding Password.Item1.Errors, Converter={StaticResource FirstValidationErrorConverter}}"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="FillAndExpand" />
                        </StackLayout>

                        <!--  Entry to get confirm password from user  -->
                        <StackLayout Grid.Row="4">
                            <border:SfBorder BorderColor="{Binding Source={x:Reference ConfirmNewPasswordEntry}, Path=IsFocused, Converter={StaticResource ColorConverter}, ConverterParameter=0}" Style="{StaticResource LoginFormBorderlessEntryBorderStyle}">
                                <Grid ColumnDefinitions="*, Auto">

                                    <control:BorderlessEntry x:Name="ConfirmNewPasswordEntry" Margin="15,0" HeightRequest="40"
                                        IsPassword="True" Placeholder="Confirm New Password" Text="{Binding Password.Item2.Value}"
                                        PlaceholderColor="{StaticResource EntryPlaceholderColor}"
                                        Style="{StaticResource BorderlessEntryStyle}" TextColor="{StaticResource Gray-White}">
                                        <Entry.Behaviors>
                                            <behaviour:EntryLineValidationBehaviour IsValid="{Binding Password.Item2.IsValid}" />
                                        </Entry.Behaviors>
                                    </control:BorderlessEntry>

                                    <!--  Label to display error icon  -->
                                    <Label Grid.Column="1" Style="{StaticResource ErrorIconLabelStyle}" Text="{StaticResource Error}"
                                        IsVisible="{Binding Path=IsVisible, Source={x:Reference ConfirmPasswordValidationLabel}}"/>
                                </Grid>
                            </border:SfBorder>

                            <!--  Label to display error message  -->
                            <Label
                                x:Name="ConfirmPasswordValidationLabel"
                                Margin="15,-3,0,0"
                                IsVisible="{Binding Password.Item2.IsValid, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SimpleLabelStyle}"
                                Text="{Binding Password.Item2.Errors, Converter={StaticResource FirstValidationErrorConverter}}"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="FillAndExpand" />

                            <Label
                                x:Name="PasswordsValidationLabel"
                                Margin="15,-3,0,0"
                                IsVisible="{Binding Password.IsValid, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource SimpleLabelStyle}"
                                Text="{Binding Password.Errors, Converter={StaticResource FirstValidationErrorConverter}}"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="FillAndExpand" />
                        </StackLayout>

                        <!--  Submit button  -->
                        <buttons:SfButton Grid.Row="5" CommandParameter="{Binding}" Command="{Binding ResetPasswordCommand}"
                            HorizontalOptions="Fill" Style="{StaticResource GradientButtonStyle}" Text="SUBMIT" />

                        <!--back to login page-->
                        <buttons:SfButton Grid.Row="6" Command="{Binding OpenLoginPageCommand}" HorizontalOptions="Fill"
                            Style="{StaticResource GradientButtonStyle}" Text="Back to login page" />
                    </Grid>

                    <!--Open Sign Up page-->
                    <StackLayout HorizontalOptions="Center" Orientation="Horizontal" Spacing="1" VerticalOptions="End">

                        <Label Style="{StaticResource DescriptionLabelStyle}" Text="Don't have an account?"
                            TextColor="{DynamicResource Gray-White}" VerticalTextAlignment="Center" />

                        <buttons:SfButton Command="{Binding OpenSignUpPageCommand}" TextColor="{DynamicResource PrimaryColor}"
                            Style="{StaticResource TransparentButtonStyle}" Text="Sign Up"/>

                    </StackLayout>

                </StackLayout>
            </ScrollView>

            <!--  Close button  -->
            <buttons:SfButton Margin="8" Command="{Binding CloseApplicationCommand}" FontSize="20" HorizontalOptions="End"
                    Style="{StaticResource IconButtonStyle}" Text="{StaticResource Close}" VerticalOptions="Start"
                    TextColor="{DynamicResource Gray-White}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>