<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:map="clr-namespace:Xamarin.Forms.Maps;assembly=Xamarin.Forms.Maps"
             x:Class="UberApp.Views.ClientHomePage"
             xmlns:viewmodel="clr-namespace:UberApp.ViewModels">


    <ContentPage.BindingContext>
        <viewmodel:ClientHomeViewModel/>
    </ContentPage.BindingContext>

    <Grid>
        <map:Map x:Name="ClientMap" 
                 IsShowingUser="true" 
                 MapType="Street" 
                 MoveToLastRegionOnLayoutChange="False"
                 TrafficEnabled="false"
                 HasZoomEnabled="True"
                 ItemsSource="{Binding Pins}">

            <map:Map.ItemTemplate>
                <DataTemplate>
                    <map:Pin Label="{Binding Label}" 
                        Position="{Binding Position}"
                         Address="{Binding Address}"/>
                </DataTemplate>
            </map:Map.ItemTemplate>

        </map:Map>
        <Button Text="Call Cab" x:Name="CallCab" HorizontalOptions="CenterAndExpand" VerticalOptions="End" Command="{Binding CallCabCommand}"/>
        <Entry HorizontalOptions="StartAndExpand"
               VerticalOptions="End"
               BackgroundColor="Black"
               TextColor="White"
               x:Name="Address" Text="{Binding Address}" Placeholder="Where dp you want to go..."></Entry>
    </Grid>
</ContentPage>